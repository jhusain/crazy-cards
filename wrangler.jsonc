{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crazy-cards",
  "main": "apps/cloudflare/src/index.ts",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "MATCHES", "class_name": "MatchRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }]
}
